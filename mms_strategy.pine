// This Pine Script™ is subject to the Terms of Use at https://www.tradingview.com/pine-script-docs/
// @version=6
// ICT Market Maker Model (MMS) - Elliott 5-Wave Reversal Strategy
// Detects 1-2-3-4-5 Elliott wave pattern, enters REVERSAL at FVG near wave 2/4
// After bullish 5-wave: SHORT at wave 4 FVG | After bearish 5-wave: LONG at wave 4 FVG

indicator("ICT MMS v2 - Elliott 5-Wave Reversal", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================
// Inputs
// ============================================================

grp_tf = "Timeframes"
trendTF    = input.timeframe("15", "Trend Timeframe", group=grp_tf)
structTF   = input.timeframe("5",  "Structure Timeframe", group=grp_tf)

grp_swing = "Swing Detection"
swingLookback = input.int(3, "Swing Lookback (candles each side)", minval=1, maxval=10, group=grp_swing)

grp_fvg = "Fair Value Gaps"
fvgMinSize   = input.float(0.5, "Min FVG Size (pts)", minval=0.1, step=0.25, group=grp_fvg)
fvgTolerance = input.float(5.0, "FVG-to-Wave Match Tolerance (pts)", minval=1.0, step=1.0, group=grp_fvg)
showFVGs     = input.bool(true, "Show FVG Zones", group=grp_fvg)

grp_wave = "Elliott Wave"
showWaves    = input.bool(true, "Show Wave Labels", group=grp_wave)
showWaveLines = input.bool(true, "Show Wave Lines", group=grp_wave)

grp_entry = "Entry / Risk"
minRR        = input.float(1.5, "Min Risk:Reward", minval=0.5, step=0.5, group=grp_entry)
maxSLpts     = input.float(50.0, "Max SL (points)", minval=5.0, step=5.0, group=grp_entry)

grp_style = "Style"
bullColor    = input.color(color.new(#00bcd4, 0), "Bullish Color", group=grp_style)
bearColor    = input.color(color.new(#ff5252, 0), "Bearish Color", group=grp_style)
waveColor    = input.color(color.new(#ffeb3b, 0), "Wave Pattern Color", group=grp_style)
fvgBullColor = input.color(color.new(#00bcd4, 85), "FVG Bullish Fill", group=grp_style)
fvgBearColor = input.color(color.new(#ff5252, 85), "FVG Bearish Fill", group=grp_style)

// ============================================================
// HTF Trend Bias (15m swing structure)
// ============================================================

[htfHigh, htfLow, htfClose] = request.security(syminfo.tickerid, trendTF, [high, low, close])

var float htfSwingHigh1 = na
var float htfSwingHigh2 = na
var float htfSwingLow1  = na
var float htfSwingLow2  = na
var int   htfTrend      = 0

htfPivotHigh = ta.pivothigh(htfHigh, swingLookback, swingLookback)
htfPivotLow  = ta.pivotlow(htfLow, swingLookback, swingLookback)

if not na(htfPivotHigh)
    htfSwingHigh2 := htfSwingHigh1
    htfSwingHigh1 := htfPivotHigh
if not na(htfPivotLow)
    htfSwingLow2 := htfSwingLow1
    htfSwingLow1 := htfPivotLow

if not na(htfSwingHigh1) and not na(htfSwingHigh2) and not na(htfSwingLow1) and not na(htfSwingLow2)
    if htfSwingHigh1 > htfSwingHigh2 and htfSwingLow1 > htfSwingLow2
        htfTrend := 1
    else if htfSwingHigh1 < htfSwingHigh2 and htfSwingLow1 < htfSwingLow2
        htfTrend := -1

bgcolor(htfTrend == 1 ? color.new(bullColor, 95) : htfTrend == -1 ? color.new(bearColor, 95) : na, title="Trend BG")

// ============================================================
// Structure TF Swing Points (5m)
// ============================================================

[stHigh, stLow, stClose, stOpen] = request.security(syminfo.tickerid, structTF, [high, low, close, open])

stPivotHigh = ta.pivothigh(stHigh, swingLookback, swingLookback)
stPivotLow  = ta.pivotlow(stLow, swingLookback, swingLookback)

// Store swing history in arrays
var array<float> swingPrices = array.new<float>()
var array<int>   swingBars   = array.new<int>()
var array<int>   swingTypes  = array.new<int>()  // 1=high, -1=low

if not na(stPivotHigh)
    array.push(swingPrices, stPivotHigh)
    array.push(swingBars, bar_index - swingLookback)
    array.push(swingTypes, 1)
    label.new(bar_index - swingLookback, stPivotHigh, "SH", style=label.style_label_down,
              color=color.new(bearColor, 60), textcolor=color.white, size=size.tiny)

if not na(stPivotLow)
    array.push(swingPrices, stPivotLow)
    array.push(swingBars, bar_index - swingLookback)
    array.push(swingTypes, -1)
    label.new(bar_index - swingLookback, stPivotLow, "SL", style=label.style_label_up,
              color=color.new(bullColor, 60), textcolor=color.white, size=size.tiny)

// Keep last 20 swings
if array.size(swingPrices) > 20
    array.shift(swingPrices)
    array.shift(swingBars)
    array.shift(swingTypes)

// ============================================================
// FVG Detection on Structure TF
// ============================================================

bullFvgTop    = stLow
bullFvgBottom = stHigh[2]
isBullFVG     = bullFvgTop > bullFvgBottom and (bullFvgTop - bullFvgBottom) >= fvgMinSize

bearFvgTop    = stLow[2]
bearFvgBottom = stHigh
isBearFVG     = bearFvgTop > bearFvgBottom and (bearFvgTop - bearFvgBottom) >= fvgMinSize

var array<box> fvgBoxes = array.new<box>()

if showFVGs and isBullFVG
    b = box.new(bar_index - 2, bullFvgTop, bar_index + 20, bullFvgBottom,
                bgcolor=fvgBullColor, border_color=bullColor, border_width=1)
    array.push(fvgBoxes, b)

if showFVGs and isBearFVG
    b = box.new(bar_index - 2, bearFvgTop, bar_index + 20, bearFvgBottom,
                bgcolor=fvgBearColor, border_color=bearColor, border_width=1)
    array.push(fvgBoxes, b)

if array.size(fvgBoxes) > 50
    box.delete(array.shift(fvgBoxes))

// ============================================================
// Elliott 5-Wave Detection
// ============================================================

// We need at least 5 alternating swings
var bool bullish5Wave = false
var bool bearish5Wave = false
var float w1Price = na
var float w2Price = na
var float w3Price = na
var float w4Price = na
var float w5Price = na
var int   w1Bar = na
var int   w2Bar = na
var int   w3Bar = na
var int   w4Bar = na
var int   w5Bar = na

bullish5Wave := false
bearish5Wave := false

sz = array.size(swingTypes)

if sz >= 5
    // Check last 5 swings for pattern
    t1 = array.get(swingTypes, sz - 5)
    t2 = array.get(swingTypes, sz - 4)
    t3 = array.get(swingTypes, sz - 3)
    t4 = array.get(swingTypes, sz - 2)
    t5 = array.get(swingTypes, sz - 1)

    p1 = array.get(swingPrices, sz - 5)
    p2 = array.get(swingPrices, sz - 4)
    p3 = array.get(swingPrices, sz - 3)
    p4 = array.get(swingPrices, sz - 2)
    p5 = array.get(swingPrices, sz - 1)

    b1 = array.get(swingBars, sz - 5)
    b2 = array.get(swingBars, sz - 4)
    b3 = array.get(swingBars, sz - 3)
    b4 = array.get(swingBars, sz - 2)
    b5 = array.get(swingBars, sz - 1)

    // Bullish impulse: H-L-H-L-H (highs making higher highs, lows making higher lows)
    // w1=high, w2=low, w3=high(>w1), w4=low(>w2), w5=high(>w1)
    if t1 == 1 and t2 == -1 and t3 == 1 and t4 == -1 and t5 == 1
        if p3 > p1 and p5 > p1 and p4 > p2
            bullish5Wave := true
            w1Price := p1
            w2Price := p2
            w3Price := p3
            w4Price := p4
            w5Price := p5
            w1Bar := b1
            w2Bar := b2
            w3Bar := b3
            w4Bar := b4
            w5Bar := b5

    // Bearish impulse: L-H-L-H-L (lows making lower lows, highs making lower highs)
    // w1=low, w2=high, w3=low(<w1), w4=high(<w2), w5=low(<w1)
    if t1 == -1 and t2 == 1 and t3 == -1 and t4 == 1 and t5 == -1
        if p3 < p1 and p5 < p1 and p4 < p2
            bearish5Wave := true
            w1Price := p1
            w2Price := p2
            w3Price := p3
            w4Price := p4
            w5Price := p5
            w1Bar := b1
            w2Bar := b2
            w3Bar := b3
            w4Bar := b4
            w5Bar := b5

// Draw wave pattern
if showWaves and bullish5Wave
    label.new(w1Bar, w1Price, "1", style=label.style_label_down, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w2Bar, w2Price, "2", style=label.style_label_up, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w3Bar, w3Price, "3", style=label.style_label_down, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w4Bar, w4Price, "4", style=label.style_label_up, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w5Bar, w5Price, "5", style=label.style_label_down, color=waveColor, textcolor=color.black, size=size.small)
    if showWaveLines
        line.new(w1Bar, w1Price, w2Bar, w2Price, color=waveColor, width=2)
        line.new(w2Bar, w2Price, w3Bar, w3Price, color=waveColor, width=2)
        line.new(w3Bar, w3Price, w4Bar, w4Price, color=waveColor, width=2)
        line.new(w4Bar, w4Price, w5Bar, w5Price, color=waveColor, width=2)

if showWaves and bearish5Wave
    label.new(w1Bar, w1Price, "1", style=label.style_label_up, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w2Bar, w2Price, "2", style=label.style_label_down, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w3Bar, w3Price, "3", style=label.style_label_up, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w4Bar, w4Price, "4", style=label.style_label_down, color=waveColor, textcolor=color.black, size=size.small)
    label.new(w5Bar, w5Price, "5", style=label.style_label_up, color=waveColor, textcolor=color.black, size=size.small)
    if showWaveLines
        line.new(w1Bar, w1Price, w2Bar, w2Price, color=waveColor, width=2)
        line.new(w2Bar, w2Price, w3Bar, w3Price, color=waveColor, width=2)
        line.new(w3Bar, w3Price, w4Bar, w4Price, color=waveColor, width=2)
        line.new(w4Bar, w4Price, w5Bar, w5Price, color=waveColor, width=2)

// ============================================================
// Reversal Entry Detection
// ============================================================

// After bullish 5-wave: price reverses down, SHORT when it taps FVG near wave 4
// After bearish 5-wave: price reverses up, LONG when it taps FVG near wave 4

// Check if price has reversed from wave 5
bullReversal = bullish5Wave and close < w5Price  // price dropped below wave 5 high
bearReversal = bearish5Wave and close > w5Price  // price rose above wave 5 low

// Check if current price is near wave 4 level (within FVG tolerance)
nearW4_bull = bullReversal and math.abs(close - w4Price) <= fvgTolerance
nearW4_bear = bearReversal and math.abs(close - w4Price) <= fvgTolerance

// Check if current price is near wave 2 level
nearW2_bull = bullReversal and math.abs(close - w2Price) <= fvgTolerance
nearW2_bear = bearReversal and math.abs(close - w2Price) <= fvgTolerance

// Also check for actual FVG tap (price in an FVG zone near the wave level)
// Look for recent bullish/bearish FVGs near wave 4
var bool fvgTapAtW4 = false
var bool fvgTapAtW2 = false
fvgTapAtW4 := false
fvgTapAtW2 := false

// Check recent candles for FVGs near wave 4/2 levels
for i = 1 to 20
    if i + 2 >= bar_index
        break
    // Bullish FVG (gap up)
    bfTop = stLow[i]
    bfBot = stHigh[i + 2]
    if bfTop > bfBot and (bfTop - bfBot) >= fvgMinSize
        fvgMid = (bfTop + bfBot) / 2.0
        if not na(w4Price) and math.abs(fvgMid - w4Price) <= fvgTolerance
            if low <= bfTop and high >= bfBot
                fvgTapAtW4 := true
        if not na(w2Price) and math.abs(fvgMid - w2Price) <= fvgTolerance
            if low <= bfTop and high >= bfBot
                fvgTapAtW2 := true
    // Bearish FVG (gap down)
    brTop = stLow[i + 2]
    brBot = stHigh[i]
    if brTop > brBot and (brTop - brBot) >= fvgMinSize
        fvgMid2 = (brTop + brBot) / 2.0
        if not na(w4Price) and math.abs(fvgMid2 - w4Price) <= fvgTolerance
            if low <= brTop and high >= brBot
                fvgTapAtW4 := true
        if not na(w2Price) and math.abs(fvgMid2 - w2Price) <= fvgTolerance
            if low <= brTop and high >= brBot
                fvgTapAtW2 := true

// Entry signals
// SHORT after bullish 5-wave: reversal + tap into FVG at w4 (or near w4 level)
shortSignal = bullReversal and (fvgTapAtW4 or nearW4_bull) and not na(w5Price)
// LONG after bearish 5-wave: reversal + tap into FVG at w4 (or near w4 level)
longSignal = bearReversal and (fvgTapAtW4 or nearW4_bear) and not na(w5Price)

// Secondary entries at wave 2
shortSignalW2 = bullReversal and (fvgTapAtW2 or nearW2_bull) and not shortSignal and not na(w5Price)
longSignalW2 = bearReversal and (fvgTapAtW2 or nearW2_bear) and not longSignal and not na(w5Price)

// ============================================================
// Risk Calculation
// ============================================================

var float entrySL = na
var float entryTP = na
var float entryRR = na

if shortSignal or shortSignalW2
    // SL above wave 5 (the high)
    slPrice = w5Price + 2.0
    slPts = math.abs(slPrice - close)
    // TP at wave 2 level
    tpPrice = shortSignal ? w2Price : close - slPts * 2.0
    tpPts = math.abs(close - tpPrice)
    rr = tpPts / math.max(slPts, 0.1)
    if slPts <= maxSLpts and rr >= minRR
        entrySL := slPrice
        entryTP := tpPrice
        entryRR := rr
    else
        shortSignal := false
        shortSignalW2 := false

if longSignal or longSignalW2
    // SL below wave 5 (the low)
    slPrice = w5Price - 2.0
    slPts = math.abs(close - slPrice)
    // TP at wave 2 level
    tpPrice = longSignal ? w2Price : close + slPts * 2.0
    tpPts = math.abs(tpPrice - close)
    rr = tpPts / math.max(slPts, 0.1)
    if slPts <= maxSLpts and rr >= minRR
        entrySL := slPrice
        entryTP := tpPrice
        entryRR := rr
    else
        longSignal := false
        longSignalW2 := false

// ============================================================
// Plot Signals
// ============================================================

plotshape(longSignal, title="MMS Long (w4)", location=location.belowbar,
          style=shape.triangleup, color=bullColor, size=size.normal, text="MMS\nLONG\n(w4)")
plotshape(longSignalW2, title="MMS Long (w2)", location=location.belowbar,
          style=shape.triangleup, color=color.new(bullColor, 40), size=size.small, text="MMS\nLONG\n(w2)")

plotshape(shortSignal, title="MMS Short (w4)", location=location.abovebar,
          style=shape.triangledown, color=bearColor, size=size.normal, text="MMS\nSHORT\n(w4)")
plotshape(shortSignalW2, title="MMS Short (w2)", location=location.abovebar,
          style=shape.triangledown, color=color.new(bearColor, 40), size=size.small, text="MMS\nSHORT\n(w2)")

// Draw SL/TP lines
if (longSignal or longSignalW2) and not na(entrySL)
    line.new(bar_index, entrySL, bar_index + 15, entrySL, color=color.red, width=2)
    line.new(bar_index, entryTP, bar_index + 15, entryTP, color=color.green, width=2)
    label.new(bar_index + 15, entrySL, "SL " + str.tostring(entrySL, "#.##"),
              style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 15, entryTP, "TP " + str.tostring(entryTP, "#.##") + "\nR:R " + str.tostring(entryRR, "#.#"),
              style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)

if (shortSignal or shortSignalW2) and not na(entrySL)
    line.new(bar_index, entrySL, bar_index + 15, entrySL, color=color.red, width=2)
    line.new(bar_index, entryTP, bar_index + 15, entryTP, color=color.green, width=2)
    label.new(bar_index + 15, entrySL, "SL " + str.tostring(entrySL, "#.##"),
              style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 15, entryTP, "TP " + str.tostring(entryTP, "#.##") + "\nR:R " + str.tostring(entryRR, "#.#"),
              style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)

// Draw wave 4 and wave 2 target zones
if (bullish5Wave or bearish5Wave) and not na(w4Price)
    line.new(bar_index - 5, w4Price, bar_index + 10, w4Price,
             color=color.new(waveColor, 30), style=line.style_dotted, width=2)
    label.new(bar_index + 10, w4Price, "W4 Entry Zone",
              style=label.style_label_left, color=color.new(waveColor, 50),
              textcolor=color.black, size=size.tiny)

// ============================================================
// Info Table
// ============================================================

var table infoTable = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80),
                                 border_color=color.gray, border_width=1)

if barstate.islast
    trendStr = htfTrend == 1 ? "BULLISH" : htfTrend == -1 ? "BEARISH" : "NEUTRAL"
    trendClr = htfTrend == 1 ? bullColor : htfTrend == -1 ? bearColor : color.gray

    waveStr = bullish5Wave ? "BULLISH 5-WAVE (sell reversal)" : bearish5Wave ? "BEARISH 5-WAVE (buy reversal)" : "NO PATTERN"
    waveClr = bullish5Wave ? bearColor : bearish5Wave ? bullColor : color.gray

    table.cell(infoTable, 0, 0, "ICT MMS v2", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "Elliott Reversal", text_color=color.gray, text_size=size.small)

    table.cell(infoTable, 0, 1, "15m Trend", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 1, trendStr, text_color=trendClr, text_size=size.small)

    table.cell(infoTable, 0, 2, "5-Wave Pattern", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, waveStr, text_color=waveClr, text_size=size.small)

    table.cell(infoTable, 0, 3, "Wave 5", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 3, na(w5Price) ? "N/A" : str.tostring(w5Price, "#.##") + " (SL ref)",
               text_color=color.orange, text_size=size.small)

    table.cell(infoTable, 0, 4, "Wave 4 (entry)", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 4, na(w4Price) ? "N/A" : str.tostring(w4Price, "#.##"),
               text_color=waveColor, text_size=size.small)

    table.cell(infoTable, 0, 5, "Wave 2 (entry)", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 5, na(w2Price) ? "N/A" : str.tostring(w2Price, "#.##"),
               text_color=waveColor, text_size=size.small)

    table.cell(infoTable, 0, 6, "Reversal?", text_color=color.gray, text_size=size.small)
    revStr = bullReversal ? "YES (price < w5)" : bearReversal ? "YES (price > w5)" : "NO"
    revClr = (bullReversal or bearReversal) ? color.lime : color.gray
    table.cell(infoTable, 1, 6, revStr, text_color=revClr, text_size=size.small)

    table.cell(infoTable, 0, 7, "FVG at W4?", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 7, fvgTapAtW4 ? "YES - TAPPING" : "NO",
               text_color=fvgTapAtW4 ? color.lime : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 8, "Min R:R", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 8, str.tostring(minRR, "#.#"), text_color=color.white, text_size=size.small)

// ============================================================
// Alerts
// ============================================================

alertcondition(longSignal, title="MMS Long (w4 entry)", message="MMS LONG: Bearish 5-wave reversal, FVG tap at wave 4 @ {{close}}")
alertcondition(shortSignal, title="MMS Short (w4 entry)", message="MMS SHORT: Bullish 5-wave reversal, FVG tap at wave 4 @ {{close}}")
alertcondition(longSignalW2, title="MMS Long (w2 entry)", message="MMS LONG: Bearish 5-wave reversal, FVG tap at wave 2 @ {{close}}")
alertcondition(shortSignalW2, title="MMS Short (w2 entry)", message="MMS SHORT: Bullish 5-wave reversal, FVG tap at wave 2 @ {{close}}")
alertcondition(bullish5Wave, title="Bullish 5-Wave Detected", message="Bullish 5-wave pattern complete @ {{close}} — watch for SHORT reversal")
alertcondition(bearish5Wave, title="Bearish 5-Wave Detected", message="Bearish 5-wave pattern complete @ {{close}} — watch for LONG reversal")
